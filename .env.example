# ── Google Apps Script webhook (lead intake) ──────────────────────────────────
# This endpoint receives verified leads from the Netlify Function (submit-lead).
# Deploy the Apps Script in google-apps-script/Code.gs and paste the /exec URL here.
GAS_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
# Sign up at dash.cloudflare.com → Turnstile → Add site
# Server-side secret key (never use VITE_ prefix)
TURNSTILE_SECRET=your_turnstile_secret_key_here

# Client-side site key (safe to expose — VITE_ prefix bundles it into the client)
# For local testing use: 1x00000000000000000000AA (always passes, Cloudflare test key)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Get Measurement ID from analytics.google.com → Admin → Data Streams
VITE_GA4_ID=G-XXXXXXXXXX
